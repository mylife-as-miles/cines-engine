   "comp_ratio": 2.0,
   "comp_attack_s": 0.005,
   "comp_release_s": 0.12,
   "offset_s": 0.0
  },
  "air_floor_lufs": -62
 },
 "beds": {
  "music": {
   "default": "music_main",
   "by_seq": {
    "Q01": "music_main",
    "Q02": "music_main",
    "Q03": "music_hush",
    "Q04": "music_main",
    "Q05": "music_main",
    "Q06": [
     {
      "var": "music_main",
      "until": "They look hurt",
      "fo": 0.5
     },
     {
      "var": null,
      "from": "They look hurt",
      "until": "So you run after them"
     },
     {
      "var": "music_lift",
      "from": "So you run after them",
      "fi": 0.05
     }
    ],
    "Q07": "music_main",
    "Q08": "music_main",
    "Q09": "music_hush",
    "Q10": "music_lift",
    "Q11": "music_end"
   },
   "why": "Q03 (Tuesday's guilt) and Q09 (the insight) take the hush; Friday (Q06) stops down for \"They look hurt. And you feel terrible.\" and lifts on \"So you run after them\"; the advice (Q10) takes the lift (its freeze, a cue-sheet silence, pauses the music and it resumes where it stopped); the wrap (Q11) starts the closing bed, which carries into the end screen and ends on its own final chord."
  },
  "music_main": "music_main",
  "music_hush": "music_hush",
  "music_lift": "music_lift",
  "music_end": "music_end",
  "office_room": null,
